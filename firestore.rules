rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }
    match /libraries/{libraryId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.hostUid == request.auth.uid;
      match /{subcollection=**} {
        allow read, write: if isAuth();
      }
    }
    match /members/{memberId} {
      allow read, write: if isAuth();
    }
    match /attendance/{attendanceId} {
      allow read, write: if isAuth();
    }
    match /payments/{paymentId} {
      allow read, write: if isAuth();
    }
    match /pendingActions/{actionId} {
      allow read, write: if isAuth();
    }
    match /messages/{conversationId} {
      allow read, write: if isAuth();
      match /chats/{chatId} {
        allow read, write: if isAuth();
      }
    }
    match /notifications_queue/{notifId} {
      allow read, write: if isAuth();
    }
  }
}
